# ===== PostgreSQL =====
POSTGRES_USER=fincore
POSTGRES_PASSWORD=fincore123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Databases =====
DB_AUTH=fincore_auth
DB_CUSTOMERS=fincore_customers
DB_ACCOUNTS=fincore_accounts
DB_LEDGER=fincore_ledger
DB_TRANSFERS=fincore_transfers
DB_FRAUD=fincore_fraud
DB_NOTIFICATION=fincore_notification
DB_AUDIT=fincore_audit
DB_BATCH=fincore_batch
DB_BACKOFFICE=fincore_backoffice

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_fincore_2026

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# ===== Eureka =====
EUREKA_URL=http://localhost:8761/eureka/

# ===== JWT =====
JWT_SECRET=fincore_jwt_hs512_secret_minimo_64_caracteres_2026_abel_gomez_banking

# ===== gRPC Ports =====
ACCOUNT_GRPC_PORT=9083
FRAUD_GRPC_PORT=9086
LEDGER_GRPC_PORT=9084

# ===== Banking Limits =====
DAILY_LIMIT=5000.00
TX_LIMIT=2000.00
MONTHLY_LIMIT=20000.00

# ===== Saga =====
SAGA_TIMEOUT=120
SAGA_MAX_RETRIES=3

# ===== Fraud Thresholds =====
FRAUD_SCORE_APPROVE=30
FRAUD_SCORE_REVIEW=70
FRAUD_SCORE_REJECT=70
FRAUD_VELOCITY_MAX_TX_PER_HOUR=10
FRAUD_VELOCITY_WINDOW_MINUTES=60

# ===== SMTP (Notification Service) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
